# Copy this file to .env.local and adjust if needed.

# URL of the CMS API (project-backend). Production example: https://portfolio-cms.onrender.com/api
# Uploaded images are loaded from this host too.
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# Public URL of THIS site (used for SEO tags, sitemap.xml and robots.txt)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
